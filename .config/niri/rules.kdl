    match app-id=r#"^evince$"#
    match app-id=r#"^(eog|org\.gnome\.Loupe)$"#
    opacity 0.75
}
window-rule {
    match app-id=r#"^(gnome-system-monitor|org\.gnome\.SystemMonitor|io\.missioncenter\.MissionCenter)$"# is-focused=true
    match app-id=r#"^evince$"# is-focused=true
    match app-id=r#"^(eog|org\.gnome\.Loupe)$"# is-focused=true
    opacity 0.82
}

