// Deluge — focused: 0.9 / unfocused: 0.8
window-rule {
    match app-id=r#"^deluge$"#
    opacity 0.8
}
window-rule {
    match app-id=r#"^deluge$"# is-focused=true
    opacity 0.9
}

// Seahorse — focused: 0.9 / unfocused: 0.8
window-rule {
    match app-id=r#"^seahorse$"#
    opacity 0.8
}
window-rule {
    match app-id=r#"^seahorse$"# is-focused=true
    opacity 0.9
